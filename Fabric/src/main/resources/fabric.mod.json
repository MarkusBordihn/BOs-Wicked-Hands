{
  "schemaVersion": 1,
  "id": "wicked_hands",
  "version": "${version}",
  "name": "Wicked Hands",
  "description": "Wicked Hands adds severed hands that can be found from different mobs and revived through a ritual.\nOnce revived, they become small companions that can follow you, warn you about nearby danger, help in combat, or sit on your shoulder.",
  "authors": [
    "Markus Bordihn"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/wicked-hands",
    "issues": "https://github.com/MarkusBordihn/BOs-Wicked-Hands/issues"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.markusbordihn.wickedhands.WickedHands"
    ],
    "client": [
      "de.markusbordihn.wickedhands.WickedHandsClient"
    ],
    "fabric-gametest": [
      "de.markusbordihn.wickedhands.gametest.SmokeTest"
    ]
  },
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": "${java_version_range}"
  }
}
